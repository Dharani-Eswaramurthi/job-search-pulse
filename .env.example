# Start with demo. Set live explicitly when the Google Sheet is ready.
DATA_MODE=demo
GOOGLE_SHEET_ID=
GOOGLE_RESPONSE_TAB=Form Responses 1
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value from your service-account JSON, including escaped newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
SURVEY_FORM_URL=
# Optional YYYY-MM-DD. Rows before this date are excluded (Sheet-local calendar date).
SURVEY_ROUND_START=
# Optional exact-title overrides if you rename form questions. Never map free-text columns.
HEADER_OVERRIDES_JSON={}
# Cells and cohorts below this count are withheld; minimum supported value is 10.
MIN_GROUP_SIZE=20
# Time between server reads; constrained to 60–3600 seconds.
CACHE_SECONDS=120
PORT=3000
